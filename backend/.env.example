# Security & JWT Tokens
# Generate a strong 256-bit string for production (e.g. openssl rand -hex 32)
SECRET_KEY="super-secret-key-replace-in-production"

# Google OAuth2 Settings (For "Sign in with Google")
# Get this from Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# Email Configuration (For 100% Free Welcome & Password Reset Emails)
# 1. Use a standard Gmail account.
# 2. Go to Google Account > Security > 2-Step Verification
# 3. Create an "App Password" and paste it below (it will be 16 characters, no spaces)
SMTP_USERNAME="your-email@gmail.com"
SMTP_PASSWORD="your-16-char-app-password"

# Gemini AI (For the Machine Learning generation)
GEMINI_API_KEY="your-google-gemini-api-key"

# HuggingFace (For Machine Learning Embeddings/Transformers)
HF_API_TOKEN="your-huggingface-api-token"

# Tavily (For AI Web Search)
TAVILY_API_KEY="your-tavily-api-key"

# Exa (Alternative AI Web Search)
EXA_API_KEY="your-exa-api-key"
